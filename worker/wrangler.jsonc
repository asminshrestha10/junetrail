{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "junetrail-admin-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "routes": [],
  "vars": {
    "APP_ENV": "development",
    "REPO_OWNER": "asminshrestha10",
    "REPO_NAME": "junetrail",
    "REPO_BRANCH": "main",
    "CONTENT_TYPES": "news,blogs,vehicles,products,guides,engineering",
    "ALLOWED_ORIGINS": "http://127.0.0.1:8000,https://asminshrestha10.github.io"
  }
}
